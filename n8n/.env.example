# Copy to .env and fill in. Never commit the real .env.
#
# Generate a real encryption key with:
#   openssl rand -hex 32
# This key decrypts every stored client credential. If you lose it, stored
# credentials must be re-entered. Back it up somewhere the client cannot reach.

POSTGRES_USER=n8n
POSTGRES_DB=n8n
POSTGRES_PASSWORD=CHANGE_ME_strong_password

N8N_ENCRYPTION_KEY=CHANGE_ME_openssl_rand_hex_32

# Public hostname n8n will generate webhook URLs with. Set to your reverse
# proxy hostname in production, never left as localhost for a live client.
N8N_HOST=localhost
N8N_PROTOCOL=http
WEBHOOK_URL=http://localhost:5678/

N8N_LOG_LEVEL=info
